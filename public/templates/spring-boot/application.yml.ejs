spring:
  application:
    name: <%= serviceName %>
  jackson:
    default-property-inclusion: non_null
    serialization:
      write-dates-as-timestamps: false
  webflux:
    base-path: /api
<% if (hasMysql) { %>
  datasource:
    url: ${DB_URL}
    username: ${DB_USER}
    password: ${DB_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: none
    open-in-view: false
<% } %>
<% if (hasMongodb) { %>
  data:
    mongodb:
      uri: ${MONGODB_URL}
      database: ${MONGODB_DATABASE}
<% } %>
<% if (hasRedis) { %>
  data:
    redis:
      masterreplica:
        nodes:
          - \${REDIS_MASTER_URL}:\${REDIS_PORT}
          - \${REDIS_REPLICA_URL}:\${REDIS_PORT}
<% } %>

server:
  port: 8080

management:
  endpoints:
    web:
      exposure:
        include: health,info,prometheus
  endpoint:
    health:
      show-details: always
  tracing:
    export:
      enabled: true
    sampling:
      probability: 1.0

app:
  profile: ${APP_PROFILE:dev}
  squad-name: ${APP_SQUAD_NAME:plataforma}

sofia:
  http:
    auth:
      basic: ${SOFIA_AUTH_BASIC_TOKEN}
<% if (hasFeatureFlags) { %>
  feature:
    # Add your feature flags here
    # example:
    #   enabled: ${FEATURE_EXAMPLE_ENABLED:true}
<% } %>
<% if (hasSqs) { %>

cloud:
  aws:
    region:
      static: ${AWS_REGION:us-east-1}
    credentials:
      use-default-aws-credentials-chain: true
<% } %>
<% if (hasRestClients) { %>

rest-client:
  <%= restClientName %>:
    base-url: ${REST_CLIENT_<%= restClientName.toUpperCase() %>_URL:http://localhost:8081}
<% } %>

logging:
  level:
    root: INFO
